# ==============================================================================
# VIETNAM AIR QUALITY DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Hugging Face Hub (Bắt buộc để tải dữ liệu dự báo tự động từ pipeline AI)
# Tên repository chứa dữ liệu (vd: username/dataset-name)
HF_DATASET_REPO=

# Hugging Face Access Token (Cần thiết nếu repo ở chế độ Private)
# Lấy token tại: https://huggingface.co/settings/tokens (chỉ cần quyền 'read')
HF_TOKEN=

# Đường dẫn file dự báo trên repo Hugging Face (mặc định đã được cấu hình trong pipeline AI)
REMOTE_PREDICTION_FILE=predictions/latest_predictions.csv

# 2. Cấu hình Cache & Server
# Thời gian lưu cache dữ liệu trong bộ nhớ Backend (giây, mặc định 300s = 5 phút)
CACHE_TTL_SECONDS=300

# Ngưỡng cảnh báo dữ liệu quá cũ (giờ, mặc định 4 giờ)
STALE_THRESHOLD_HOURS=4

# Server Host và Port
HOST=0.0.0.0
PORT=8000

